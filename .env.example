# Firebase (cliente — consola Firebase → Configuración del proyecto)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.europe-west1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (servidor — cuenta de servicio JSON en una sola línea)
FIREBASE_SERVICE_ACCOUNT_JSON=

# App Check (opcional)
# NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Google AdSense (opcional)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# NEXT_PUBLIC_ADSENSE_DEV=true

# reCAPTCHA v3 (mismo proyecto: clave de sitio + secreto)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# SEO
NEXT_PUBLIC_SITE_URL=https://tu-dominio.vercel.app

# Rate limit (opcional — Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Admin API (/api/admin/*) y reset de aura
ADMIN_SECRET=

# Vercel Cron (/api/cron/*)
CRON_SECRET=

# Seguridad cliente (opcional — solo producción)
# NEXT_PUBLIC_ENABLE_SECURITY_GUARD=true

# Panel QA torneo: /admin/torneo (solo dev por defecto; true en staging)
# NEXT_PUBLIC_ENABLE_TORNEO_DEV_TOOLS=true
